DISCORD_TOKEN=
CURSOR_API_KEY=

# cloud (default) or local
CURSOR_RUNTIME=cloud
CURSOR_MODEL=composer-2.5

# Cloud: repo to clone. Omit both for a no-repo cloud agent.
CURSOR_REPO_URL=
CURSOR_REPO_REF=main
CURSOR_AUTO_CREATE_PR=false

# Local runtime only
CURSOR_LOCAL_CWD=.

# Comma-separated allowlists. Empty = allow all (not recommended).
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# Require an @mention even inside an existing bot thread
DISCORD_REQUIRE_MENTION=false

DATA_DIR=./data
